# Variables de entorno de la API. En local no hace falta ninguna (modo memoria).

# memoria = datos de ejemplo sin base de datos · postgres = PostgreSQL + PostGIS
FACFOOD_REPOSITORIO=memoria

# Solo con FACFOOD_REPOSITORIO=postgres. Acepta el formato de Neon/Render (postgresql://...).
DATABASE_URL=postgresql+psycopg://facfood:facfood@localhost:5432/facfood

# Dominios del frontend que pueden llamar a la API, separados por coma (sin "/" al final).
FACFOOD_CORS=http://localhost:5173

# Secreto para firmar los JWT. En producción: una cadena larga y aleatoria.
FACFOOD_JWT_SECRETO=solo-para-desarrollo-cambiar-en-produccion
FACFOOD_JWT_HORAS=24

# true = acepta el encabezado X-Usuario-Id (botón DEV). En producción: false.
FACFOOD_PERMITIR_USUARIO_PRUEBA=true
